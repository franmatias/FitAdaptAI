{
  "name": "fitadaptai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:api": "node scripts/python.mjs -m pytest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:all": "npm run typecheck && npm run test:coverage && npm run test:api && npm run test:e2e"
  },
  "dependencies": {
    "@clerk/vue": "^2.5.12",
    "lucide-vue-next": "^0.344.0",
    "vue": "^3.4.21",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.11.24",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.4.4",
    "autoprefixer": "^10.4.18",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^2.2.0"
  }
}
